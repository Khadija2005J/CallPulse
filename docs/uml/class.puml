@startuml class
' CallPulse - domain class diagram (Domain layer only).
' Source: docs/cahier-des-charges.md sections 4 and 7 (RG-01 to RG-45), spec v1.0.
' The Domain layer depends on nothing: no EF Core, no SignalR, no ASP.NET Core (BNF-14).
' Times are UTC (RG-38, BNF-28); methods that need the time receive "now" from an injectable clock.
' Labels and notes are in French (BNF-25); identifiers are in English.

title CallPulse — Diagramme de classes du domaine (MVP)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Domain" {

  ' ---------- Enumerations ----------
  enum Role {
    Agent
    Supervisor
    Administrator
  }

  enum AgentStatus {
    Available
    OnCall
    OnBreak
    Offline
  }

  enum StatusActor {
    Agent
    Supervisor
    System
  }

  enum StatusChangeError {
    SameStatus
    InvalidTransition
    CallInProgress
    ActorNotAllowed
  }

  enum CallStatus {
    Waiting
    Assigned
    InProgress
    Completed
    Abandoned
  }

  enum RoutingStrategyType {
    LongestIdle
    RoundRobin
  }

  enum SlaLevel {
    Green
    Orange
    Red
    NotApplicable
  }

  enum SlaParameter {
    Threshold
    Objective
    OrangeBand
    Window
  }

  ' ---------- Accounts and organisation ----------
  class User {
    + Id : int
    + Email : string
    + DisplayName : string
    + Role : Role
    + IsActive : bool
    --
    + Deactivate() : void
  }

  class Team {
    + Id : int
    + Name : string
  }

  class Skill {
    + Id : int
    + Name : string
  }

  class Agent {
    + Id : int
    + UserId : int
    + TeamId : int?
    + Status : AgentStatus = Offline
    + StatusChangedAt : DateTimeOffset
    + LastAvailableAt : DateTimeOffset?
    + LogoutPending : bool
    --
    + ChangeStatus(target : AgentStatus, actor : StatusActor, now : DateTimeOffset) : StatusChangeResult
    + RequestLogout(now : DateTimeOffset) : void
    + IsEligibleFor(queue : Queue) : bool
    + TimeInStatus(now : DateTimeOffset) : TimeSpan
  }

  class AgentSkill {
    + Level : int? <<Could BF-40>>
  }

  class StatusChangeResult <<value object>> {
    + IsAccepted : bool
    + Error : StatusChangeError?
    + History : AgentStatusHistory?
  }

  class AgentStatusHistory {
    + Id : long
    + AgentId : int
    + FromStatus : AgentStatus
    + ToStatus : AgentStatus
    + Actor : StatusActor
    + ActorUserId : int?
    + ChangedAt : DateTimeOffset
  }

  ' ---------- Queues, SLA and calls ----------
  class Queue {
    + Id : int
    + Name : string
    + TeamId : int
    + RequiredSkillId : int
    + Priority : int = 2 {1..3}
    + MaxPatienceSeconds : int = 120
    + Strategy : RoutingStrategyType = LongestIdle
    + LastServedAgentId : int?
    + IsActive : bool = true
    --
    + Deactivate(hasOpenCalls : bool) : void
    + AcceptsNewCalls() : bool
  }

  class SlaPolicy {
    + QueueId : int
    + ThresholdSeconds : int = 20
    + ObjectivePercent : decimal = 80
    + OrangeBandPoints : decimal = 10
    + WindowMinutes : int = 30
    --
    + IsWithinThreshold(waitTime : TimeSpan) : bool
    + ComputeRate(answeredWithinThreshold : int, counted : int) : decimal?
    + LevelFor(rate : decimal?) : SlaLevel
  }

  class SlaPolicyAudit {
    + Id : long
    + QueueId : int
    + Parameter : SlaParameter
    + OldValue : decimal
    + NewValue : decimal
    + ChangedByUserId : int
    + ChangedAt : DateTimeOffset
  }

  class Call {
    + Id : long
    + QueueId : int
    + RequiredSkillId : int
    + AgentId : int?
    + Status : CallStatus = Waiting
    + ArrivedAt : DateTimeOffset
    + AnsweredAt : DateTimeOffset?
    + EndedAt : DateTimeOffset?
    + SimulatedDuration : TimeSpan
    + MetSlaThreshold : bool?
    + AppliedThresholdSeconds : int?
    --
    + Assign(agent : Agent, sla : SlaPolicy, now : DateTimeOffset) : void
    + Complete(now : DateTimeOffset) : void
    + Abandon(sla : SlaPolicy, now : DateTimeOffset) : void
    + WaitingTime(now : DateTimeOffset) : TimeSpan
  }
}

' ---------- Associations (every end has a cardinality) ----------
User "1" -- "0..1" Agent : est >
Team "0..1" -- "0..*" Agent : regroupe >
Agent "0..*" -- "0..*" Skill : possède >
(Agent, Skill) .. AgentSkill
Agent "1" *-- "0..*" AgentStatusHistory : historique >

Team "1" -- "0..*" Queue : est rattachée <
Skill "1" -- "0..*" Queue : est requise par >
Queue "1" *-- "1" SlaPolicy : cible >
Queue "1" -- "0..*" SlaPolicyAudit : journal >
User "1" -- "0..*" SlaPolicyAudit : auteur >

Queue "1" -- "0..*" Call : contient >
Agent "0..1" -- "0..*" Call : traite >

Agent ..> StatusChangeResult : crée
Call ..> SlaPolicy : utilise

' ---------- Business rules carried by the classes ----------
note right of Agent
  <b>Règle de changement d'état (RG-01 à RG-10)</b>
  ChangeStatus applique la table des transitions 7.2
  dans l'ordre d'évaluation :
  1. OnCall et acteur ≠ System → CallInProgress (APPEL_EN_COURS)
  2. statut demandé = statut courant → SameStatus (STATUT_IDENTIQUE)
  3. case « Refusée » → InvalidTransition (TRANSITION_INVALIDE)
  4. acteur absent de la case → ActorNotAllowed (ACTEUR_NON_AUTORISE)
  5. sinon : accepté, StatusChangedAt = now,
     une ligne AgentStatusHistory est créée (RG-09).
  Un refus ne modifie rien (RG-03, RG-10).
  RG-07 : LogoutPending → Hors ligne à la fin de l'appel.
end note

note right of SlaPolicy
  <b>Calcul SLA (RG-29 à RG-36)</b>
  IsWithinThreshold : attente < T (strict, RG-29)
  ComputeRate : dans le seuil / comptabilisés × 100 ;
  null (« N/A ») si comptabilisés = 0 (RG-32, RG-35)
  LevelFor : vert si taux ≥ O ; orange si O − N ≤ taux < O ;
  rouge si taux < O − N ; N/A si null (RG-34)
end note

note bottom of Call
  <b>Cycle de vie (RG-11 à RG-17)</b>
  Waiting → Assigned → InProgress → Completed
  Waiting → Abandoned (attente ≥ P, RG-15)
  Completed et Abandoned sont finaux.
  Assign passe Assigned puis InProgress dans le même
  traitement : AnsweredAt = instant de décroché (RG-13).
  MetSlaThreshold et AppliedThresholdSeconds sont fixés
  au décroché ou à l'abandon, jamais recalculés (RG-39, RG-40) ;
  un abandon est toujours hors seuil (RG-31).
end note

note bottom of Queue
  <b>Suppression logique (RG-42 à RG-44)</b>
  Deactivate refuse si des appels sont
  Waiting, Assigned ou InProgress (FILE_NON_VIDE).
  Sinon IsActive = false ; les appels restent
  dans l'historique.
end note

@enduml
